rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    // Keep in sync with src/lib/admin.ts
    function adminEmail() {
      return signedIn() && myEmail() in ['emp0@abcd0650'];
    }

    function employeePath() {
      return /databases/$(database)/documents/employees/$(request.auth.uid);
    }

    function activeStaff() {
      return signedIn()
        && exists(employeePath())
        && get(employeePath()).data.active == true;
    }

    function superAdmin() {
      return adminEmail()
        || (activeStaff() && get(employeePath()).data.role == 'super_admin');
    }

    // Listing belongs to the signed-in employee (by UID or by email).
    function ownsListing(data) {
      return data.created_by_staff_id == request.auth.uid
        || (data.get('created_by_email', '') != '' && data.get('created_by_email', '') == myEmail());
    }

    match /employees/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || superAdmin());
      allow list: if superAdmin();

      // Self sign-up: an employee creates only their own record, always as a normal active employee.
      // The admin email may create its own record as super_admin.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'phone', 'role', 'active', 'created_at', 'uid'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email == myEmail()
        && request.resource.data.active == true
        && (request.resource.data.role == 'employee'
            || (request.resource.data.role == 'super_admin' && adminEmail()));

      // Admin creating employees through the server API.
      allow create: if superAdmin()
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'phone', 'role', 'active', 'created_at', 'uid'])
        && request.resource.data.role in ['employee', 'super_admin'];

      // An employee may change only their display name.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80;

      allow update: if superAdmin()
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'phone', 'role', 'active', 'created_at', 'uid'])
        && request.resource.data.role in ['employee', 'super_admin'];

      allow delete: if superAdmin() && request.auth.uid != uid;
    }

    match /properties/{propertyId} {
      allow read: if resource.data.published == true || activeStaff() || superAdmin();

      allow create: if (activeStaff() || superAdmin())
        && request.resource.data.created_by_staff_id == request.auth.uid
        && request.resource.data.get('created_by_email', '') in ['', myEmail()];

      // Admin: full control. Employee: only their own listings, and cannot hand them to someone else.
      allow update: if superAdmin()
        || (activeStaff()
            && ownsListing(resource.data)
            && request.resource.data.created_by_staff_id == resource.data.created_by_staff_id
            && request.resource.data.get('created_by_email', '') == resource.data.get('created_by_email', ''));

      allow delete: if superAdmin() || (activeStaff() && ownsListing(resource.data));
    }

    match /property_owners/{propertyId} {
      allow read: if activeStaff() || superAdmin();
      allow create: if superAdmin()
        || (activeStaff() && request.resource.data.created_by_staff_id == request.auth.uid);
      allow update: if superAdmin()
        || (activeStaff()
            && resource.data.created_by_staff_id == request.auth.uid
            && request.resource.data.created_by_staff_id == resource.data.created_by_staff_id);
      allow delete: if superAdmin()
        || (activeStaff() && resource.data.created_by_staff_id == request.auth.uid);
    }
  }
}
